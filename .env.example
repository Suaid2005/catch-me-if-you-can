# ═══════════════════════════════════════════════════════════════════
# Catch Me If You Can? — Root Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════

# ── Backend Configuration (Render / Server) ───────────────────────
PORT=8000
APP_NAME=CatchMeIfYouCan
APP_ENV=production
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-minimum
DATABASE_URL=postgresql://postgres.yourprojectref:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres
FRONTEND_URL=https://catch-me-if-you-can.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://catch-me-if-you-can.vercel.app
ENABLE_HEAVY_EMBEDDINGS=false

# ── Frontend Configuration (Vercel) ───────────────────────────────
NEXT_PUBLIC_API_URL=https://catch-me-if-you-can-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://catch-me-if-you-can-backend.onrender.com
