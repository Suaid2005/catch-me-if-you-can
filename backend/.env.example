# ═══════════════════════════════════════════════════════════════════
# Catch Me If You Can? — Backend Environment Variables (.env.example)
# ═══════════════════════════════════════════════════════════════════

# ── Application Configuration ──────────────────────────────────────
APP_NAME=CatchMeIfYouCan
APP_ENV=production
# Generate a secure 32+ character random secret for production JWT tokens:
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Server Port ───────────────────────────────────────────────────
# Render automatically injects the PORT variable. Default fallback is 8000.
PORT=8000

# ── Database (Supabase PostgreSQL) ────────────────────────────────
# Local development:
# DATABASE_URL=sqlite+aiosqlite:///./catchme.db

# Production Supabase PostgreSQL:
# Copy the connection string from: Supabase Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[project-ref]:[DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Note: The backend automatically transforms 'postgresql://' or 'postgres://' into 'postgresql+asyncpg://'
DATABASE_URL=postgresql://postgres.yourprojectref:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Production CORS & Frontend Domains ────────────────────────────
# Explicit frontend URL (e.g. your deployed Vercel URL)
FRONTEND_URL=https://catch-me-if-you-can.vercel.app

# Comma-separated list of allowed origins (localhost + custom domains)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://catch-me-if-you-can.vercel.app

# ── AI / ML Free-Tier Memory Optimization ──────────────────────────
# Set to 'false' on Render 512MB free tier to use lightweight N-gram vectorizer (<15MB RAM, instant cold start)
# Set to 'true' only on machines with >= 2GB RAM to load full sentence-transformers all-MiniLM-L6-v2 weights
ENABLE_HEAVY_EMBEDDINGS=false
BOT_LM_MODEL=gpt2
CHAT_EMBED_MODEL=all-MiniLM-L6-v2

# ── Optional External Redis ────────────────────────────────────────
# In-memory single worker engine runs ₹0 free without requiring Redis.
# If using an external Redis provider (e.g. Upstash free tier):
# REDIS_URL=rediss://default:password@your-upstash-endpoint.upstash.io:6379
