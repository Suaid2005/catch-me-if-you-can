# ═══════════════════════════════════════════════════════════════════
# Catch Me If You Can? — Frontend Environment Variables (.env.example)
# ═══════════════════════════════════════════════════════════════════

# Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Production Deployment (Set in Vercel Project Settings -> Environment Variables):
# Point this to your Render.com Web Service URL:
NEXT_PUBLIC_API_URL=https://catch-me-if-you-can-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://catch-me-if-you-can-backend.onrender.com
